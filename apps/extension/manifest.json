{
  "manifest_version": 3,
  "name": "WebMCP Gateway",
  "version": "0.1.0",
  "description": "Discovers page WebMCP tools and forwards them to the local mcp2webmcp Gateway. This extension is not an MCP server.",
  "action": {
    "default_title": "WebMCP Gateway",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["picker-model.js", "content-isolated.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["webmcp-runtime-polyfill.js", "content-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
