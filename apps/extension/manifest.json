{
  "manifest_version": 3,
  "name": "WebMCP Gateway",
  "version": "0.1.0",
  "description": "Discovers page WebMCP tools and forwards them to the local mcp2webmcp Gateway. This extension is not an MCP server.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebMCP Gateway"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["webmcp-runtime-polyfill.js", "content-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
